---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Flores para sacarte una sonrisa',
	description = 'Un pequeño detalle, sin apuro y con cariño.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/flowers/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" content="#fbf3e3" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
  @font-face { font-family: 'Caveat'; src: url('/fonts/caveat-latin.woff2') format('woff2'); font-weight: 400 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Nunito'; src: url('/fonts/nunito-latin.woff2') format('woff2'); font-weight: 200 1000; font-style: normal; font-display: swap; }
	:root {
		--cream: #fbf3e3;
		--cream-deep: #f3e7ce;
		--paper: #fffcf4;

		--yellow: #f4c430;
		--yellow-soft: #f8d35e;
		--yellow-pale: #fbe7a8;
		--white-petal: #fffbef;

		--pink: #e39cb0;
		--pink-deep: #d67f98;
		--pink-text: #a8456a;
		--pink-pale: #f6dce3;

		--brown: #4a3423;
		--brown-soft: #8a6f52;
		--green: #93a878;
		--green-deep: #748a5c;

		--kraft: #d8b78d;
		--kraft-deep: #c29f70;

		--font-script: 'Caveat', cursive;
		--font-body: 'Nunito', system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		background: var(--cream);
		font-family: var(--font-body);
		color: var(--brown);
		-webkit-font-smoothing: antialiased;
	}


	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>


