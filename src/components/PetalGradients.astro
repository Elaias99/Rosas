---
// Degradados de pétalo/hoja compartidos: base más saturada -> punta más clara,
// para que cada pétalo lea con un poco de volumen en vez de ir plano.
---

<linearGradient id="gY" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#d99a24" />
	<stop offset="100%" stop-color="#f8d35e" />
</linearGradient>
<linearGradient id="gYSoft" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#e7ad3a" />
	<stop offset="100%" stop-color="#fbe7a8" />
</linearGradient>
<linearGradient id="gCream" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#e8d3a4" />
	<stop offset="100%" stop-color="#fffbef" />
</linearGradient>
<linearGradient id="gWhite" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#e9e0cf" />
	<stop offset="100%" stop-color="#ffffff" />
</linearGradient>
<linearGradient id="gBlush" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#d67f98" />
	<stop offset="100%" stop-color="#fbe3ea" />
</linearGradient>
<linearGradient id="gLeaf" x1="0.5" y1="1" x2="0.5" y2="0">
	<stop offset="0%" stop-color="#5f7a48" />
	<stop offset="100%" stop-color="#a3bd82" />
</linearGradient>
